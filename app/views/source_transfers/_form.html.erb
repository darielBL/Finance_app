<%= form_with model: transfer, local: true do |f| %>
  <% if transfer.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(transfer.errors.count, "error") %> impidieron guardar la transferencia:</h4>
      <ul>
        <% transfer.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :from_account_id, "Desde (origen)", class: "form-label" %>
      <%= f.collection_select :from_account_id,
                              @accounts,
                              :id,
                              :name,
                              { prompt: "Selecciona origen..." },
                              class: "form-select" %>
    </div>

    <div class="col-md-6 mb-3" id="to_account_field">
      <%= f.label :to_account_id, "Hacia (destino)", class: "form-label" %>
      <%= f.collection_select :to_account_id,
                              @accounts,
                              :id,
                              :name,
                              { prompt: "Selecciona destino..." },
                              class: "form-select" %>
    </div>

    <div class="col-md-6 mb-3 d-none" id="goal_destination_info">
      <label class="form-label">Hacia (destino)</label>
      <div class="form-control-plaintext fw-bold" id="goal_account_name"></div>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :goal_id, "Vincular a meta", class: "form-label" %>
    <%= f.collection_select :goal_id,
                            @goals,
                            :id,
                            ->(g) { "#{g.name} (#{g.progress_percentage}%)" },
                            { prompt: "Transferencia entre cuentas..." },
                            class: "form-select",
                            data: { goals: @goals.map { |g| { id: g.id, account_id: g.target_account_id, account_name: g.target_account&.name } }.to_json } %>
    <small class="text-muted">Al seleccionar una meta, el destino se completa automáticamente con la cuenta asociada y el monto se registra como progreso.</small>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :normalized_amount, "Monto", class: "form-label" %>
      <%= f.number_field :normalized_amount,
                         class: "form-control",
                         step: 0.01,
                         required: true,
                         placeholder: "0.00",
                         value: transfer.normalized_amount %>
    </div>

    <div class="col-md-3 mb-3">
      <%= f.label :amount_currency, "Moneda", class: "form-label" %>
      <%= f.select :amount_currency, ["CUP", "USD", "EUR", "MXN"], {}, class: "form-select" %>
    </div>

    <div class="col-md-3 mb-3">
      <%= f.label :transferred_at, "Fecha", class: "form-label" %>
      <%= f.date_field :transferred_at, class: "form-control", required: true %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :notes, "Notas", class: "form-label" %>
    <%= f.text_area :notes, class: "form-control", rows: 2, placeholder: "Motivo de la transferencia (opcional)..." %>
  </div>

  <%= f.hidden_field :amount_cents %>

  <%= f.submit transfer.new_record? ? "Guardar Transferencia" : "Actualizar Transferencia", class: "btn btn-primary" %>
  <%= link_to "Cancelar", source_transfers_path, class: "btn btn-secondary" %>
<% end %>

<script>
  (function() {
    var goalSelect = document.getElementById('source_transfer_goal_id');
    var toAccountSelect = document.getElementById('source_transfer_to_account_id');
    var toField = document.getElementById('to_account_field');
    var goalInfo = document.getElementById('goal_destination_info');
    var goalAccountName = document.getElementById('goal_account_name');

    if (!goalSelect) return;

    var goalsData = {};
    try {
      var raw = goalSelect.getAttribute('data-goals');
      if (raw) JSON.parse(raw).forEach(function(g) { goalsData[g.id] = g; });
    } catch(e) {}

    function updateDestination() {
      var goalId = goalSelect.value;
      var goal = goalsData[goalId];

      if (goal && goal.account_id) {
        toAccountSelect.value = goal.account_id;
        toAccountSelect.disabled = true;
        toField.classList.add('d-none');
        goalAccountName.textContent = goal.account_name;
        goalInfo.classList.remove('d-none');
      } else {
        toAccountSelect.value = '';
        toAccountSelect.disabled = false;
        toField.classList.remove('d-none');
        goalInfo.classList.add('d-none');
      }
    }

    goalSelect.addEventListener('change', updateDestination);
    updateDestination();
  })();
</script>
